{
  "name": "loud-and-cana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "export": "node scripts/build-standalone.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/database-backup.mjs backup",
    "db:verify": "node --env-file-if-exists=.env scripts/database-backup.mjs verify",
    "db:restore": "node --env-file-if-exists=.env scripts/database-backup.mjs restore",
    "release": "npm run build && npm run export && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@zxing/library": "^0.23.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "vite": "^6.0.7"
  }
}
