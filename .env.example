# Copy to .env locally; enter real values only in private server/hosting settings.
PORT=3000
DATABASE_PATH=.local/orders.sqlite
BUSINESS_NAME=Loud + Cana
BUSINESS_JURISDICTION=Gauteng, South Africa
PICKUP_ADDRESS=
CONTACT_EMAIL=
DELIVERY_ZIPS=
STORE_LICENSE_NUMBER=
# Administrator login: username admin. Minimum 16 characters; never commit it.
ADMIN_PASSWORD=
# Staff login: username staff. Minimum 16 characters and different from admin.
# Leave blank until genuine staff access is needed; no staff login while unset.
STAFF_PASSWORD=
# Independent, stable 64-character hexadecimal key for encrypted ID/selfie uploads.
# Generate privately with: openssl rand -hex 32
# Keep the result out of source/chat/build logs; back it up securely separately.
# Missing/invalid configuration blocks image submission. Do not regenerate on deploy.
IDENTITY_UPLOAD_KEY=
# Keep these disabled until lawful sales authorization and catalog are confirmed.
LIVE_ORDERS_ENABLED=false
LEGAL_SALES_AUTHORIZATION_CONFIRMED=false
CATALOG_APPROVED=false
# Hosting origin, including https://. Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_ORIGIN=
