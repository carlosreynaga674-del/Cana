# Copy to .env locally; enter real values only in private server/hosting settings.
PORT=3000
DATABASE_PATH=.local/orders.sqlite
BUSINESS_NAME=Loud + Cana
BUSINESS_JURISDICTION=Gauteng, South Africa
PICKUP_ADDRESS=
CONTACT_EMAIL=loudpluscana@protonmail.com
DELIVERY_ZIPS=
STORE_LICENSE_NUMBER=
# Administrator login: username admin. Minimum 16 characters; never commit it.
ADMIN_PASSWORD=
# Optional legacy shared login only; leave blank for individual staff accounts.
# Create employees in Admin → Staff accounts instead; their passwords live as hashes in SQLite.
# If retained temporarily, the legacy secret needs >=16 characters and must differ from admin.
STAFF_PASSWORD=
# Independent, stable 64-character hexadecimal key for encrypted ID/selfie uploads.
# Generate privately with: openssl rand -hex 32
# Keep the result out of source/chat/build logs; back it up securely separately.
# Missing/invalid configuration blocks image submission. Do not regenerate on deploy.
IDENTITY_UPLOAD_KEY=
# Keep these disabled until lawful sales authorization and catalog are confirmed.
LIVE_ORDERS_ENABLED=false
LEGAL_SALES_AUTHORIZATION_CONFIRMED=false
CATALOG_APPROVED=false
# Hosting origin, including https://. Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_ORIGIN=
# Optional transactional welcome mail: select smtp or resend and configure that sender.
# All values below belong in private hosting settings; no actual credentials here.
# Leave unconfigured until a genuine mailbox or verified sender is available.
# Proton's direct SMTP requires a paid plan and custom-domain sender;
# the @protonmail.com address below is the public contact and reply destination.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=loudpluscana@protonmail.com
# Optional account-link origin; defaults to PUBLIC_ORIGIN or Render's external URL.
EMAIL_PUBLIC_ORIGIN=
# SMTP: 465 uses TLS; 587 and 2525 require STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Resend alternative: authorised verified-domain sender plus a server-only API key.
RESEND_API_KEY=
