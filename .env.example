# Copy to .env locally; enter real values only in private server/hosting settings.
PORT=3000
DATABASE_PATH=.local/orders.sqlite
BUSINESS_NAME=Loud + Cana
BUSINESS_JURISDICTION=Gauteng, South Africa
PICKUP_ADDRESS=
CONTACT_EMAIL=
DELIVERY_ZIPS=
STORE_LICENSE_NUMBER=
# Minimum 16 characters; use a unique random secret. Never commit the value.
ADMIN_PASSWORD=
# Keep these disabled until lawful sales authorization and catalog are confirmed.
LIVE_ORDERS_ENABLED=false
LEGAL_SALES_AUTHORIZATION_CONFIRMED=false
CATALOG_APPROVED=false
# Hosting origin, including https://. Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_ORIGIN=
